# Copy to backend/.env (never commit the real file).
# Everything is optional: with no values set, the app runs in demo mode.

# --- Backend (FastAPI) ---
PLAYLISTIQ_ENVIRONMENT=development
PLAYLISTIQ_CORS_ORIGINS=["http://127.0.0.1:3000"]
PLAYLISTIQ_FRONTEND_URL=http://127.0.0.1:3000

# Spotify live mode (not wired up yet; see docs/spotify-compatibility.md).
# Client ID from https://developer.spotify.com/dashboard. PKCE means no client secret is needed.
PLAYLISTIQ_SPOTIFY_CLIENT_ID=
# Must match a Redirect URI registered on the Spotify app exactly. Spotify rejects "localhost";
# use the loopback IP.
PLAYLISTIQ_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback
# Long random string used to sign session cookies, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
PLAYLISTIQ_SESSION_SECRET=

# Postgres from docker-compose.yml (used by live mode for cached playlists and export jobs).
PLAYLISTIQ_DATABASE_URL=postgresql+psycopg://playlistiq:playlistiq@127.0.0.1:5432/playlistiq

# --- Frontend (Next.js) ---
# Where the Next.js server proxies /api requests.
PLAYLISTIQ_API_URL=http://127.0.0.1:8000
